# Backend
APP_NAME=moodle-ai-assistant
APP_ENV=development
API_KEY=change-me
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database / Vector store (PostgreSQL + pgvector)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=moodle_ai
POSTGRES_USER=moodle_ai
POSTGRES_PASSWORD=moodle_ai_password
DATABASE_URL=postgresql+psycopg://moodle_ai:moodle_ai_password@db:5432/moodle_ai

# Moodle integration (configure per site)
MOODLE_BASE_URL=https://your-moodle-site.example
MOODLE_WS_TOKEN=replace-with-moodle-service-token

# RAG / LLM (placeholders for Sprint 2+)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Optional: local Moodle stack (docker-compose moodle services)
MOODLE_SITE_URL=http://localhost:8080
MOODLE_USERNAME=admin
MOODLE_PASSWORD=Admin123!
MOODLE_EMAIL=admin@example.com
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle_password
MOODLE_DB_ROOT_PASSWORD=root_password
